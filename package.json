{
  "name": "appium-chromedriver",
  "version": "9.0.3",
  "description": "Node.js wrapper around chromedriver.",
  "keywords": [
    "android",
    "appium",
    "chrome"
  ],
  "bugs": {
    "url": "https://github.com/appium/appium/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-chromedriver.git"
  },
  "directories": {
    "lib": "lib"
  },
  "files": [
    "config",
    "lib",
    "build/lib",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "npm run build -- --watch",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "prepare": "npm run build",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "test": "node --enable-source-maps --test --test-force-exit --test-timeout=60000 \"./build/test/unit/**/*.spec.js\"",
    "e2e-test": "node --enable-source-maps --test --test-force-exit --test-concurrency=1 --test-timeout=600000 \"./build/test/functional/**/*.spec.js\""
  },
  "dependencies": {
    "@appium/base-driver": "^10.0.0-rc.2",
    "@appium/support": "^7.2.2",
    "@xmldom/xmldom": "^0.x",
    "appium-adb": "^16.0.0",
    "asyncbox": "^6.0.1",
    "axios": "^1.16.0",
    "compare-versions": "^6.0.0",
    "semver": "^7.0.0",
    "teen_process": "^4.0.4",
    "xpath": "^0.x"
  },
  "devDependencies": {
    "@appium/oxc-config": "^1.1.0",
    "@appium/semantic-release-config": "^1.1.0",
    "@appium/tsconfig": "^1.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/semver": "^7.0.0",
    "@types/sinon": "^22.0.0",
    "esmock": "^2.7.6",
    "sinon": "^22.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  }
}
